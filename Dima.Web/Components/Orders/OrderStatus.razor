@inherits OrderStatusComponent

@switch (Status)
{
    case EOrderStatus.Canceled:
        <MudChip T="EOrderStatus" Color="Color.Error">CANCELADO</MudChip>
    break;

      case EOrderStatus.Paid:
        <MudChip T="EOrderStatus"  Color="Color.Success">PAGO</MudChip>
     break;

        case EOrderStatus.Refunded:
        <MudChip T="EOrderStatus" Color="Color.Info">ESTORNADO</MudChip>
     break;

        case EOrderStatus.WaitingPayment:
        <MudChip T="EOrderStatus" Color="Color.Warning">AGUARDANDO PAGAMENTO</MudChip>
     break;

        default:
        <MudChip T="EOrderStatus" Color="Color.Info">NAO DEFINIDO</MudChip>
     break;
}